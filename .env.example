# Django Settings
SECRET_KEY=django-insecure-dicoevent-super-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=*

# PostgreSQL Database
DATABASE_NAME=dicoevent
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Redis Cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Celery Broker
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# MinIO Object Storage
MINIO_ENDPOINT_URL=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=dicoevent-posters
MINIO_USE_SSL=False

# SMTP / Mailpit
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
